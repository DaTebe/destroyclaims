@prefix odrl: <http://www.w3.org/ns/odrl/2/> .
@prefix eol: <http://example.com/odrl-eol#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dct: <http://purl.org/dc/terms/> .

#################################################################
# New simple properties that are part of an odrl:Policy         #
#################################################################

eol:simulated a rdf:Property, owl:ObjectProperty, skos:Concept ;
    rdfs:label "Simulated"@en ;
    skos:definition "Indicates whether the ODRL policy is executed in simulation mode."@en ;
    skos:note "TBD"@en ;
    rdfs:domain odrl:Policy ;
    rdfs:range xsd:boolean .

eol:active a rdf:Property, owl:ObjectProperty, skos:Concept ;
    rdfs:label "Active"@en ;
    skos:definition "Indicates whether the ODRL policy is active and should be observed and executed."@en ;
    skos:note "TBD"@en ;
    rdfs:domain odrl:Policy ;
    rdfs:range xsd:boolean .

# eol:automatedExecution
eol:optIn a rdf:Property, owl:ObjectProperty, skos:Concept ;
    rdfs:label "OptIn"@en ;
    skos:definition "Indicates whether the execution of the ODRL policy is active and should be observed and executed."@en ;
    skos:note "TBD"@en ;
    rdfs:domain odrl:Policy ;
    rdfs:range xsd:boolean .

# eol:strictInterpretation
eol:strict a rdf:Property, owl:ObjectProperty, skos:Concept ;
    rdfs:label "Strict"@en ;
    skos:definition "Indicates whether the ODRL policy should only be automatically executed if all classes, properties and values are known to the machine."@en ;
    skos:note "TBD"@en ;
    rdfs:domain odrl:Policy ;
    rdfs:range xsd:boolean .

# maybe exchange with dct:valid!
eol:expires a rdf:Property, owl:ObjectProperty, skos:Concept ;
    rdfs:subPropertyOf dct:valid ;
    rdfs:label "Expires"@en ;
    skos:definition "The date from which the policy may no longer be interpreted and executed."@en ;
    skos:note "This is regardless of constraints. Required as an expiration date so that policies do not have to be repeatedly checked and executed and can be removed."@en ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf ( odrl:Policy odrl:Rule ) ;
    ] ;
    rdfs:range xsd:dateTime .

#################################################################
## Wh-Question: WHAT                                            #
#################################################################  

# Define Locator as a class
eol:Locator a rdfs:Class, owl:Class, skos:Concept ;
    rdfs:label "Locator" ;
    skos:definition "A class representing an locator. "@en ;
    skos:note "A class to describe detailed locations of an Asset, allowing various addressing methods. E.g. content hash, file path, uid, or other."@en .

eol:hasLocator a rdf:Property, owl:ObjectProperty ;
    rdfs:label "hasLocator"@en ;
    skos:definition "Associates an Asset or AssetCollection with its Locator."@en ;
    rdfs:domain odrl:AssetCollection ;
    rdfs:range eol:Locator .

eol:locatorSHA256Hash a rdf:Property ;
    rdfs:label "SHA256 Hash Locator"@en ;
    skos:definition "The SHA256 hash of the Asset's content."@en ;
    rdfs:domain eol:Locator ;
    rdfs:range xsd:string .

#################################################################
## Wh-Question: WHY                                             #
#################################################################    

eol:Reason a rdfs:Class, owl:Class, skos:Concept ;
    rdfs:label "Reason"@en ;
    skos:definition "Representation of a reason why the Policy, Rule, or Action exists."@en ;
    skos:note "Provide more context on the assignee side. For example, if a deletion rule has to be executed for security reasons, a data protection officer may be informed."@en .

eol:hasReason a rdf:Property, owl:ObjectProperty, skos:Concept ;
    rdfs:label "Reason for a Policy, Rule, or Action."@en ;
    skos:definition "Associates a Policy, Rule, or Action with its underlying reason."@en ;
    rdfs:domain [
        a owl:Class ;
        owl:unionOf ( odrl:Policy odrl:Rule odrl:Action ) ;
    ] ;
    rdfs:range eol:Reason .
    
#################################################################    
## Wh-Question: HOW                                             #
## Answering HOW using the refinement property of an action.    #
#################################################################

# Define the destruction level constraint's left operand
eol:destructionLevel a odrl:LeftOperand, skos:Concept ;
    rdfs:label "Destruction Level"@en ;
    skos:definition "Specifies the required level of destruction for the asset."@en .

# Define the Destruction Level concept scheme
eol:DestructionLevelScheme a skos:ConceptScheme ;
    skos:prefLabel "Destruction Level Scheme"@en .

# destructionLevel Recycled
eol:Recycled a odrl:RightOperand, skos:Concept ;
    skos:inScheme eol:DestructionLevelScheme ;
    rdfs:label "Recycled"@en ;
    skos:definition "Indicates that the asset must be put in the recycle bin or marked as deleted."@en ;
    skos:note "The data should be moved to the recycle bin only. If the data is in a database, it should be moved to a special recycle table/database or be marked as deleted." .

# destructionLevel Deleted
eol:Deleted a skos:Concept ;
    skos:inScheme eol:DestructionLevelScheme ;
    skos:prefLabel "Deleted"@en ;
    skos:definition "The asset is marked as deleted on the storage systems."@en ;
    skos:note "In this level, data is marked as deleted. For files, this is done by the operating system. Usually the data remains on the hardware and is overwritten by new data at some point by chance. Special tools can often be used to restore the data. That the data existed is traceable by existing metadata. In database a soft delete flag SHOULD be used." .

# destructionLevel MetadataDestroyed
eol:MetadataDestroyed a skos:Concept ;
    skos:inScheme eol:DestructionLevelScheme ;
    skos:prefLabel "Metadata Destroyed"@en ;
    skos:definition "Only metadata associated with the asset is destroyed."@en ;
    skos:note "At this level, the metadata is also deleted. However, the data remains on the hardware until it is overwritten. Restoring requires reading the entire hardware, since the location of the data pieces is unknown." .

# destructionLevel Wiped
eol:Wiped a skos:Concept ;
    skos:inScheme eol:DestructionLevelScheme ;
    skos:prefLabel "Wiped"@en ;
    skos:definition "The data must be erased from the hardware using a special erasure method that guarantees that the data cannot be recovered. An example of such a method is the Gutmann algorithm."@en ;
    eol:wipeAlgorithm eol:WipingAlgorithms .

eol:wipeAlgorithm a rdf:Property, owl:ObjectProperty, skos:Concept ;
    rdfs:label "Wipe Algorithm"@en ;
    skos:definition "Used algorithm to wipe data."@en ;
    skos:note "Algorithm that should be used for wiping data from the storage system."@en .

eol:WipingAlgorithms a skos:Collection ;
    skos:prefLabel "Wiping Algorithms"@en ;
    skos:member eol:GutmannAlgorithm, eol:DOD5220Algorithm .

eol:GutmannAlgorithm a skos:Concept ;
    skos:prefLabel "Gutmann Algorithm"@en ;
    skos:definition "A secure data erasure method involving 35 overwrite passes."@en ;
    rdfs:seeAlso <https://en.wikipedia.org/wiki/Gutmann_method> .

eol:DOD5220Algorithm a skos:Concept ;
    skos:prefLabel "DOD 5220.22-M Algorithm"@en ;
    skos:definition "A data sanitization standard by the U.S. Department of Defense."@en .

# destructionLevel PhysicallyDestroyed
eol:PhysicallyDestroyed a skos:Concept ;
    skos:inScheme eol:DestructionLevelScheme ;
    skos:prefLabel "Physically Destroyed"@en ;
    skos:definition "The hardware on which the data is physically stored must be destroyed. Usually, a DCA will not be able to perform this level."@en .


