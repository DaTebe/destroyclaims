{
  "@context": [
    "http://www.w3.org/ns/odrl.jsonld",
    {
      "eol": "http://example.com/destroyclaims/1/"
    }
  ],
  "uid": "http://example.com/policy/123",
  "dct:issued": "2017-01-01T12:00",
  "dct:modified": "2018-03-12T13:00",
  "dct:title": "Delete the world",
  "dct:description": "We delete everything",
  "dct:subject": "secret, error, wow",
  "obligation": [
    {
      "eol:simulated": false,
      "eol:strict": true,
      "eol:notification": true,
      "eol:optIn": false,
      "target": {
        "@type": "Asset",
        "eol:hasLocator": [
          {
            "@type": "Locator",
            "eol:locatorSHA256Hash": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"
          }
        ]
      },
      "assigner": "http://example.com/org:43",
      "assignee": "http://example.com/org:44",
      "constraint": {
        "odrl:leftOperand": "odrl:dateTime",
        "odrl:operator": "odrl:gt",
        "odrl:rightOperand": "2025-12-31T23:59:59Z",
        "skos:note": "Rule Expiration Date"
      },
      "action": [
        {
          "@id": "odrl:delete",
          "eol:hasReason": "http://example.com/destroyclaims:reason:data-quality:accessibility:access-security",
          "refinement": [
            {
              "leftOperand": "eol:destructionLevel",
              "operator": "eq",
              "rightOperand": "http://example.com/destructionmethod/gutman-xyz"
            }
          ]
        }
      ]
    }
  ]
}




// simulieren können
// manuell oder automatisch ausführen beschreuben können

// Policy signieren können
// Strict mode -> nur ausführen wenn alle vokabulare und Werte bekannt sind und nicht Best Guess Work
// policy existiert auch deaktiviert zu Testzwecken, oder zum Aussetzen bei Fehlern, oder Compliance problemen etc.
// Neue Rollen für Parties (aktuell nur Data Owner -> Target owner)

// Parties benachrichten können -> info jetzt direkt bei Party und nicht global -> flexibler
// Destroy Reason nun Teil der Action -> je nach Action (Löschen oder Archivieren) ist der Grund evtl anders -> Optimierung

